application {
  config {
    baseName Gateway
    applicationType gateway
    packageName backend.jshong.poc.jhipster.gateway
    buildTool gradle
    serverPort 8080
    serviceDiscoveryType consul
    authenticationType oauth2
    databaseType no
    devDatabaseType no
    prodDatabaseType no
    cacheProvider no
    enableSwaggerCodegen true
    messageBroker no
    websocket no
    clientFramework react
    enableTranslation true
    nativeLanguage ko
    languages [ko, en]
    testFrameworks [gatling]
  }
}
